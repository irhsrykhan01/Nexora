# Command prefix (1–3 characters, no spaces)
PREFIX=.

# Display name used in bot information and the terminal dashboard
BOT_NAME=Nexora

# WhatsApp session directory. Keep private and never commit it.
AUTH_DIR=./data/auth

# Persistent non-secret settings (group welcome/goodbye)
DATA_FILE=./data/nexora.json

# Log level: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Per-user cooldown between commands, in milliseconds (0 disables it)
COMMAND_COOLDOWN_MS=1000
